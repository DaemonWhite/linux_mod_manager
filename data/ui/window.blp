using Gtk 4.0;
using Adw 1;

template $LinuxModManagerWindow : $AdwApplicationWindow {
  default-width: 900;
  default-height: 600;

  Adw.Breakpoint window_breakpoint {
    condition ("max-width: 850sp")

    setters {
      view_switcher_bar.reveal: true;
    }
  }

  Gtk.Box {
  	orientation: vertical;
  	vexpand: true;
  	hexpand: true;
  	Adw.ToolbarView {
  		[top]
			Adw.HeaderBar header_bar {
				title-widget: Adw.ViewSwitcher view_switcher_title{
				  policy: wide;
					stack: main_stack;
				};
		  	[start]
		  	Gtk.DropDown choose_game {
		  	  enable-search: true;
		  	}
		    [end]
		    Gtk.MenuButton {
					primary: true;
					icon-name: 'open-menu-symbolic';
					tooltip-text: 'Menu';
					menu-model: primary_menu;
		    }
		    [end]
		    Gtk.MenuButton {
					tooltip-text: 'Menu';
					child: Overlay {
					  Spinner _spinner {
					    spinning: false;
					    visible: false;
					  }

					  Image _image {
					    icon-name: 'object-select-symbolic';
					  }
					};

					popover: Gtk.Popover {
					  styles["menu"]
					  Adw.ViewStack _stack_popover {
              Adw.ViewStackPage {
                name: 'empty';
                child: Gtk.Label {
                  label: "Pas de télèchargement ou d'installation en cours";
                };
              }
					  }
					};
		    }
		  }
		  Adw.ViewStack main_stack{
		  	vexpand: true;
		  	Adw.ViewStackPage {
		  	      name: "order";
		  	      title: _("Order");
		  	      child: $OrderStack order_stack {};
		  	}
		  	Adw.ViewStackPage {
		  	      name: "settings";
		  	      title: _("Settings");
		  	      child: $SettingsStack settings_stack {};
		  	}

		  }
		  [bottom]
			Adw.ViewSwitcherBar view_switcher_bar {
			  stack: main_stack;
			}
		}
  }
}

menu primary_menu {
  section {
    item {
      label: "_Preferences";
      action: "app.preferences";
    }
   item {
      label: "_Keyboard Shortcuts";
      action: "win.show-help-overlay";
    }
    item {
      label: "_About SortPictureResolve-gui";
      action: "app.about";
    }
  }
}